<PhoenixKitWeb.Components.LayoutWrapper.app_layout
  socket={@socket}
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={gettext("Crawler Settings")}
  page_subtitle={
    gettext(
      "Decide who may read this site — indexing directives, per-bot access, and what crawlers and AI assistants are told."
    )
  }
  current_path={@current_path}
  project_title={@project_title}
  current_locale={@current_locale}
>
  <div class="px-4 py-6 space-y-6">
    <div class="card bg-base-100 shadow-xl border border-base-200">
      <div class="card-body space-y-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm uppercase tracking-wide text-primary font-semibold">
              {gettext("Robots Directive")}
            </p>
            <h2 class="text-2xl font-bold">{gettext("Noindex · Nofollow")}</h2>
            <p class="text-base text-base-content/70">
              {gettext("Adds")}
              <code class="font-mono text-sm bg-base-200 rounded px-1.5 py-0.5">
                &lt;meta name="robots" content="noindex,nofollow"&gt;
              </code>
              {gettext(
                "to every PhoenixKit layout, blocking crawlers from indexing or following links."
              )}
            </p>
          </div>
          <label class="flex items-center gap-2 cursor-pointer">
            <span class="text-sm font-semibold text-base-content/70">
              {if @no_index_enabled, do: gettext("Enabled"), else: gettext("Disabled")}
            </span>
            <input
              type="checkbox"
              class="toggle toggle-primary toggle-lg"
              checked={@no_index_enabled}
              phx-click="toggle_no_index"
            />
          </label>
        </div>

        <div class={[
          "alert",
          if(@no_index_enabled, do: "alert-warning", else: "alert-info"),
          "bg-base-200/70"
        ]}>
          <.icon
            name={
              if @no_index_enabled, do: "hero-no-symbol", else: "hero-magnifying-glass-circle"
            }
            class="w-6 h-6"
          />
          <div class="text-sm leading-relaxed">
            <%= if @no_index_enabled do %>
              {gettext(
                "Search engines are instructed to skip this environment. Remove this before launch."
              )}
            <% else %>
              {gettext(
                "Crawlers are allowed to index the site. Enable the toggle to hide staging deployments."
              )}
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl border border-base-200">
      <div class="card-body space-y-4">
        <div>
          <p class="text-sm uppercase tracking-wide text-primary font-semibold">
            {gettext("Bot Access")}
          </p>
          <h2 class="text-2xl font-bold">{gettext("Who may crawl this site")}</h2>
          <p class="text-base text-base-content/70">
            {gettext(
              "Grouped by why they visit. Blocking a group writes it into the generated robots.txt below; everything defaults to allowed."
            )}
          </p>
        </div>

        <div class="divide-y divide-base-200">
          <div :for={group <- @groups} class="py-3 flex items-start justify-between gap-4">
            <div>
              <p class="font-semibold">{group.label}</p>
              <p class="text-sm text-base-content/60">{group.description}</p>
              <p class="text-xs text-base-content/50 font-mono mt-1">
                {Enum.map_join(group.bots, " · ", & &1.token)}
              </p>
            </div>
            <label class="flex items-center gap-2 cursor-pointer shrink-0">
              <span class="text-sm font-semibold text-base-content/70">
                {if @group_allowed[group.key], do: gettext("Allowed"), else: gettext("Blocked")}
              </span>
              <input
                type="checkbox"
                class="toggle toggle-primary"
                checked={@group_allowed[group.key]}
                phx-click="toggle_group"
                phx-value-group={group.key}
              />
            </label>
          </div>
        </div>
      </div>
    </div>

    <%!-- robots.txt: generated for copy-paste, never written. See the
         LiveView moduledoc for why PhoenixKit does not serve this file. --%>
    <div class="card bg-base-100 shadow-xl border border-base-200">
      <div class="card-body space-y-4">
        <div>
          <p class="text-sm uppercase tracking-wide text-primary font-semibold">
            {gettext("Crawler Instructions")}
          </p>
          <h2 class="text-2xl font-bold">robots.txt</h2>
          <p class="text-base text-base-content/70">
            {gettext(
              "PhoenixKit does not serve this file — it is yours, served from priv/static before any route is consulted. This is the complete file your toggles above describe: paste it into priv/static/robots.txt."
            )}
          </p>
        </div>

        <div class="relative">
          <pre
            id="pk-robots-txt-output"
            class="font-mono text-sm bg-base-200 rounded p-3 overflow-x-auto whitespace-pre"
          >{@robots_txt}</pre>
          <button
            type="button"
            class="btn btn-sm btn-outline absolute top-2 right-2"
            phx-hook="CopyToClipboard"
            id="pk-robots-txt-copy"
            data-copy-target="#pk-robots-txt-output"
          >
            <.icon name="hero-clipboard-document" class="w-4 h-4" />
            <span data-copy-idle>{gettext("Copy")}</span>
            <span data-copy-feedback class="hidden">{gettext("Copied!")}</span>
          </button>
        </div>

        <div class={[
          "alert bg-base-200/70",
          if(@robots_txt_present? and @robots_txt_references_sitemap?,
            do: "alert-success",
            else: "alert-info"
          )
        ]}>
          <.icon
            name={
              if @robots_txt_present? and @robots_txt_references_sitemap?,
                do: "hero-check-circle",
                else: "hero-information-circle"
            }
            class="w-6 h-6"
          />
          <div class="text-sm leading-relaxed">
            <%= cond do %>
              <% not @robots_txt_present? -> %>
                {gettext(
                  "No priv/static/robots.txt found. Without one, crawlers assume everything is allowed — and any groups you blocked above are not being told."
                )}
              <% not @robots_txt_references_sitemap? -> %>
                {gettext(
                  "priv/static/robots.txt exists but has no Sitemap: line. Paste the file above so crawlers are told where to look."
                )}
              <% true -> %>
                {gettext("priv/static/robots.txt points crawlers at your sitemap.")}
            <% end %>
          </div>
        </div>

        <p class="text-xs text-base-content/60">
          {gettext(
            "The noindex toggle and robots.txt are separate mechanisms: noindex is a per-page meta tag that tells crawlers not to index what they fetched, while robots.txt tells them what not to fetch at all. A staging site usually wants both."
          )}
        </p>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl border border-base-200">
      <div class="card-body space-y-4">
        <div>
          <p class="text-sm uppercase tracking-wide text-primary font-semibold">
            {gettext("AI Discovery")}
          </p>
          <h2 class="text-2xl font-bold">llms.txt</h2>
          <p class="text-base text-base-content/70">
            {gettext(
              "The other half of bot policy: a markdown summary telling AI assistants what this site is about, served at"
            )}
            <a href={@llms_txt_url} target="_blank" class="link link-primary font-mono text-sm">
              {@llms_txt_url}
            </a>
            {gettext(
              "while this module is enabled. The heading comes from your project title; everything below it is yours."
            )}
          </p>
        </div>

        <form phx-submit="save_llms_txt" id="pk-llms-txt-form" class="space-y-3">
          <textarea
            name="extra"
            rows="6"
            class="textarea textarea-bordered w-full font-mono text-sm"
            placeholder={
              gettext("Optional markdown: a summary paragraph, key links, docs pointers…")
            }
          >{@llms_txt_extra}</textarea>
          <div class="flex items-center justify-between gap-4">
            <p class="text-xs text-base-content/60">
              {gettext("Preview of the served file:")}
            </p>
            <button type="submit" class="btn btn-primary btn-sm">{gettext("Save")}</button>
          </div>
        </form>

        <pre class="font-mono text-xs bg-base-200 rounded p-3 overflow-x-auto whitespace-pre">{@llms_txt_preview}</pre>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl border border-base-200">
      <div class="card-body space-y-4">
        <div>
          <p class="text-sm uppercase tracking-wide text-primary font-semibold">
            {gettext("Verification")}
          </p>
          <h2 class="text-2xl font-bold">{gettext("Search engine verification")}</h2>
          <p class="text-base text-base-content/70">
            {gettext(
              "Paste the verification content Google Search Console or Bing Webmaster Tools gives you — the meta tags are added to every layout head. Pasting the whole <meta> tag also works; the content value is extracted."
            )}
          </p>
        </div>

        <form phx-submit="save_verifications" id="pk-verifications-form" class="space-y-3">
          <label class="form-control w-full">
            <span class="label-text font-medium mb-1">
              Google <span class="font-mono text-xs">(google-site-verification)</span>
            </span>
            <input
              type="text"
              name="google"
              value={@google_verification}
              class="input input-bordered w-full font-mono text-sm"
              autocomplete="off"
            />
          </label>
          <label class="form-control w-full">
            <span class="label-text font-medium mb-1">
              Bing <span class="font-mono text-xs">(msvalidate.01)</span>
            </span>
            <input
              type="text"
              name="bing"
              value={@bing_verification}
              class="input input-bordered w-full font-mono text-sm"
              autocomplete="off"
            />
          </label>
          <div class="flex justify-end">
            <button type="submit" class="btn btn-primary btn-sm">{gettext("Save")}</button>
          </div>
        </form>
      </div>
    </div>

    <div class="card bg-base-100 shadow-xl border border-base-200">
      <div class="card-body space-y-4">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm uppercase tracking-wide text-primary font-semibold">
              {gettext("Enforcement")}
            </p>
            <h2 class="text-2xl font-bold">{gettext("Block at the application")}</h2>
            <p class="text-base text-base-content/70">
              {gettext(
                "Answer 403 to requests whose User-Agent matches a blocked group, for bots that ignore robots.txt."
              )}
            </p>
          </div>
          <label class="flex items-center gap-2 cursor-pointer shrink-0">
            <span class="text-sm font-semibold text-base-content/70">
              {if @block_at_app, do: gettext("On"), else: gettext("Off")}
            </span>
            <input
              type="checkbox"
              class="toggle toggle-primary toggle-lg"
              checked={@block_at_app}
              phx-click="toggle_block_at_app"
            />
          </label>
        </div>

        <div class="alert alert-info bg-base-200/70">
          <.icon name="hero-information-circle" class="w-6 h-6" />
          <div class="text-sm leading-relaxed">
            {gettext(
              "Advisory-grade: anything can send any User-Agent, so a scraper that lies passes through. Real enforcement belongs at your CDN or reverse proxy — this catches the honest-but-ignorant. Bots identified only by robots.txt tokens (Google-Extended, Applebot-Extended) crawl under their main user agent and are never matched here, so blocking AI training cannot 403 Googlebot."
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</PhoenixKitWeb.Components.LayoutWrapper.app_layout>
