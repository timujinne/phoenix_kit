<PhoenixKitWeb.Components.AuthPageWrapper.auth_page_wrapper
  flash={@flash}
  phoenix_kit_current_scope={assigns[:phoenix_kit_current_scope]}
  page_title={@page_title}
  current_path={assigns[:url_path] || "/users/referral"}
>
  <h1 class="text-2xl font-bold text-center mb-2">
    {gettext("Enter your referral code")}
  </h1>
  <p class="text-center text-base-content/60 text-sm mb-6">
    {gettext("This site is invite-only. Enter the code you were given to continue.")}
  </p>

  <.form for={@form} id="referral_gate_form" phx-submit="redeem">
    <fieldset class="fieldset min-w-0">
      <legend class="fieldset-legend sr-only">{gettext("Referral code")}</legend>
      <.input
        field={@form[:code]}
        type="text"
        label={gettext("Referral code")}
        autocomplete="off"
        autocapitalize="characters"
        required
      />
      <%= if @error do %>
        <p class="text-error text-sm mt-2" role="alert">{@error}</p>
      <% end %>
      <button
        type="submit"
        phx-disable-with={gettext("Checking...")}
        class="btn btn-primary w-full mt-4 transition-all hover:scale-[1.02] active:scale-[0.98]"
      >
        {gettext("Continue")} <span aria-hidden="true">→</span>
      </button>
    </fieldset>
  </.form>

  <div class="text-center mt-4 text-sm">
    <.link
      href={Routes.path("/users/log-out")}
      method="delete"
      class="font-semibold text-primary hover:underline"
    >
      {gettext("Log out")}
    </.link>
  </div>
</PhoenixKitWeb.Components.AuthPageWrapper.auth_page_wrapper>
